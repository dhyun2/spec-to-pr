{
  "name": "@spec-to-pr/plugin",
  "version": "1.0.4",
  "private": true,
  "type": "module",
  "description": "A lightweight skill for turning four delivery cases into Korean draft pull requests.",
  "packageManager": "pnpm@10.34.4",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "format": "prettier . --write --ignore-unknown",
    "format:check": "prettier . --check --ignore-unknown",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "plugin:validate": "node scripts/lite/validate-plugin.mjs",
    "guide:check": "node scripts/lite/validate-guide.mjs",
    "check": "pnpm build && pnpm format:check && pnpm typecheck && pnpm test && pnpm plugin:validate && pnpm guide:check",
    "release:build": "pnpm check && node scripts/lite/verify-release.mjs",
    "release:verify": "pnpm release:build"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pngjs": "^6.0.5",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.0",
    "tsup": "^8.0.0",
    "typescript": "^5.9.3",
    "vitest": "^3.0.0"
  },
  "pnpm": {
    "overrides": {
      "esbuild": "0.28.1"
    }
  }
}
