{
  "name": "@spec-to-pr/plugin",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Evidence-driven Codex workflow for full delivery, legacy migration, feature E2E, and Figma implementation.",
  "packageManager": "pnpm@10.34.4",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "format": "prettier . --write --ignore-unknown",
    "format:check": "prettier . --check --ignore-unknown",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "guide:assets": "tsx scripts/build-guide-visual-assets.ts",
    "guide:check": "node tests/browser/four-case-guide.mjs",
    "policy:sync": "node scripts/sync-delivery-mode-policy.mjs",
    "policy:check": "node scripts/sync-delivery-mode-policy.mjs --check",
    "schemas:build": "tsx scripts/export-runtime-schemas.ts",
    "schemas:check": "node scripts/check-generated-files.mjs schemas/runtime",
    "release:build": "tsx scripts/build-release.ts",
    "release:verify": "tsx scripts/publish-release.ts --verify-only",
    "release:publish": "tsx scripts/publish-release.ts",
    "release:publish:dry-run": "tsx scripts/publish-release.ts --dry-run",
    "release:update:local": "tsx scripts/publish-release.ts --skip-verify --skip-push --skip-tag",
    "release:update:claude": "tsx scripts/publish-release.ts --skip-verify --skip-push --skip-tag --local-target claude",
    "release:update:codex": "tsx scripts/publish-release.ts --skip-verify --skip-push --skip-tag --local-target codex",
    "sdk:typecheck": "pnpm --dir packages/codex-sdk typecheck",
    "sdk:build": "pnpm --dir packages/codex-sdk build",
    "sdk:check-dist": "node scripts/check-generated-files.mjs packages/codex-sdk/dist",
    "bundle:check-dist": "node scripts/check-generated-files.mjs dist/mcp",
    "check": "pnpm sdk:typecheck && pnpm sdk:build && pnpm sdk:check-dist && pnpm format:check && pnpm typecheck && pnpm schemas:build && pnpm schemas:check && pnpm build && pnpm bundle:check-dist && pnpm test",
    "plugin:validate": "pnpm plugin:validate:claude && pnpm plugin:validate:codex",
    "plugin:validate:claude": "claude plugin validate . --strict",
    "plugin:validate:codex": "tsx scripts/validate-codex-plugin.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "pdfjs-dist": "6.1.200",
    "pngjs": "^7.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pngjs": "^6.0.5",
    "playwright": "^1.61.1",
    "prettier": "^3.9.0",
    "tsup": "^8.0.0",
    "tsx": "^4.22.4",
    "typescript": "^5.8.0",
    "vitest": "^3.0.0",
    "yaml": "^2.9.0"
  },
  "pnpm": {
    "overrides": {
      "esbuild": "0.28.1"
    }
  }
}
