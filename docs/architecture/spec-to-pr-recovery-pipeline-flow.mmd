flowchart TD
  C["계약 승인<br/>캡처 방식·기하·원격 호스트 확정"] --> I["구현 제출 preflight<br/>Git snapshot·현재 cycle 확인"]
  I -->|"같은 snapshot"| ID["멱등 성공"]
  I -->|"새 snapshot"| R["Implementation cycle 교체<br/>이전 packet은 불변 보존"]
  I -->|"첫 제출"| P["Review packet 생성"]
  R --> P
  P --> F["기능 리뷰"]
  P --> V0["시각 제출 freshness 검사"]
  V0 -->|"packet/head 불일치"| RQ["수정 필요<br/>새 cycle만 안내"]
  V0 --> V1["캡처 획득 event 기록"]
  V1 -->|"계약·기하 오류"| BG["영구 진단<br/>비교 횟수 미소모"]
  V1 --> BC["runtime BrowserCaptureAdapter 실행"]
  BC -->|"환경 오류"| RG["재시도 가능 진단<br/>비교 횟수 미소모"]
  BC -->|"획득 성공"| V2["baseline·actual을 Run에 귀속"]
  V2 --> V3["whole-frame 또는 tile 비교"]
  V3 --> V4["diff·overlay·원인 영역을 Run에 귀속"]
  V4 -->|"실패, 1·2차"| RR["시각 보정 필요<br/>lineage 유지"]
  RR --> R
  V4 -->|"통과"| D["디자인 리뷰"]
  V4 -->|"3차 실패"| TG["최종 시각 Gap"]
  F --> B["리뷰 barrier"]
  D --> B
  TG --> B
  B --> RP["간결한 한국어 보고서"]
  RP --> PP["동일 transport로 원격 preflight"]
  PP -->|"신뢰·권한 오류"| PD["게시 대기<br/>로컬 결과와 산출물 보존"]
  PP -->|"성공"| TX["Publication transaction"]
  TX --> CL["CAS claim·lease·fencing token"]
  CL --> GP["Git source push"]
  GP --> M["기존 Draft 조회·검증"]
  M -->|"기존 1건"| U["누락 asset만 업로드"]
  M -->|"0건"| CR["Draft create issued"]
  CR -->|"응답 확인"| U
  CR -->|"응답 불명"| UC["uncertain 격리·반복 reconcile"]
  UC -->|"원격 발견"| U
  UC -->|"계속 불명"| PD
  U --> S["본문 동기화"]
  S --> Q["원격 재조회로 완료 확인"]
  PD -->|"설정 복구 후"| PP
  Q -->|"완료"| GC["보존 정책에 따른 정리"]

  subgraph Trust["호스트 신뢰 설정"]
